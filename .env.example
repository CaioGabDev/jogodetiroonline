# Copie para .env (local) ou cadastre em Vercel -> Settings -> Environment Variables.
# Use UMA das opções abaixo para habilitar um servidor TURN (relay).

# Opção A: Metered (plano gratuito). Domínio e chave de API do painel do Metered.
VITE_METERED_DOMAIN=
VITE_METERED_API_KEY=

# Opção B: TURN com credenciais fixas (ex.: coturn próprio). URLs separadas por vírgula.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Contas, perfil e ranking (opcional: sem isto o jogo funciona só com convidados).
# Só a chave anon/publishable vai aqui. NUNCA coloque a service_role: tudo que começa com VITE_ fica visível no navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Use true depois de configurar o provedor Google no Supabase. Sem isso, o botão fica escondido.
VITE_GOOGLE_LOGIN=
